module ssd_phone_number (
    input [2:0] selector_in, // 3-bit input to select the digit to display
    output reg [3:0] phone_digit,
    output [6:0] ssd_out);

    wire [31:0] mux_in = 32'408F1290; 
    
    always @(*) begin
        phone_digit = mux_in[selector_in * 4 +: 4];
    end

    ssd_driver driver_inst (
        .enable(1'b1), 
        .binary_in(phone_digit), 
        .ssd_out(ssd_out)
    );

endmodule