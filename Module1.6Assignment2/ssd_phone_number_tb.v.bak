module ssd_phone_number_tb (
    output wire [3:0] phone_digit,
    output wire [6:0] ssd_out
);

    reg [2:0] selector_in;

    ssd_phone_number uut (
        .selector_in(selector_in),
        .phone_digit(phone_digit),
        .ssd_out(ssd_out)
    );

    initial begin
        selector_in = 3'b000;
        
        repeat (8) begin
            #10;
            selector_in = selector_in + 1'b1;
        end
        
        #10 $finish;
    end

endmodule